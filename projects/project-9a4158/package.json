{
  "name": "vertical-reframe",
  "version": "1.0.0",
  "private": true,
  "description": "Перекадрирование широкого видео в вертикальное 9:16: ручное ведение мышью и автоведение по говорящему",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "node scripts/build.mjs && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "setup:browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
