# LOOM v5 - имена переменных без значений. Копировать в .env, заполнять руками.

# Переопределение корня состояния (журнал + projects/) - используется тестами.
# Не задан = живой режим, состояние хранится в текущем каталоге LOOM.
LOOM_HOME=

# Прямые API-ключи моделей - используются ТОЛЬКО выключенной HTTP-веткой шлюза (v2).
# Провайдер v1 (claude-cli) работает через подписку Claude Code, ключ не нужен.
ANTHROPIC_API_KEY=
